# Configuración de la aplicación
APP_NAME=estimador-cag
ENVIRONMENT=development
DEBUG=true
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR o CRITICAL
LOG_LEVEL=INFO
# Formato de logs: "console" (legible, desarrollo) o "json" (producción)
LOG_FORMAT=console

# Proveedor LLM preferido: "openai" o "anthropic"
LLM_PROVIDER=anthropic
# Si el preferido falla, rotar al otro proveedor (solo si tiene API key)
LLM_FALLBACK_ENABLED=true
# Timeout por llamada (segundos) y reintentos sobre el mismo proveedor
# antes de rotar al siguiente (solo errores transitorios: timeout, rate
# limit, 5xx, conexión)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048

# Caché exact-match de respuestas (en memoria, por proceso)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=256

# Versión de los prompts (carpeta app/prompts/estimation/<versión>/)
PROMPT_VERSION=v1

# API keys (dejar vacío en este archivo de ejemplo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Requerido solo si la ANTHROPIC_API_KEY no está vinculada a un workspace por
# defecto (error 400 "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=

# Modelos por proveedor (mejor un snapshot fechado que un alias, para que
# el mismo prompt dé resultados reproducibles)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# URL base de la API REST que consume el cliente de Streamlit
# (streamlit_app.py). Por defecto asume la API corriendo en local con
# uvicorn; en docker-compose se sobreescribe a http://api:8000.
API_BASE_URL=http://localhost:8000
