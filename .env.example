# Configuración de la aplicación
APP_NAME=estimador-cag
ENVIRONMENT=development
DEBUG=true
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR o CRITICAL
LOG_LEVEL=INFO

# Proveedor LLM activo: "openai" o "anthropic"
LLM_PROVIDER=anthropic

# API keys (dejar vacío en este archivo de ejemplo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Requerido solo si la ANTHROPIC_API_KEY no está vinculada a un workspace por
# defecto (error 400 "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=

# Modelos por proveedor
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# URL base de la API REST que consume el chat de Streamlit
# (streamlit_app.py). Por defecto asume la API corriendo en local con
# uvicorn; en docker-compose se sobreescribe a http://api:8000.
API_BASE_URL=http://localhost:8000
