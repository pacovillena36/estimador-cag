# Configuración de la aplicación
APP_NAME=estimador-cag
ENVIRONMENT=development
DEBUG=true
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR o CRITICAL
LOG_LEVEL=INFO
# Formato de logs: "console" (legible, desarrollo) o "json" (producción)
LOG_FORMAT=console

# Proveedor LLM preferido: "openai" o "anthropic"
LLM_PROVIDER=anthropic
# Si el preferido falla, rotar al otro proveedor (solo si tiene API key)
LLM_FALLBACK_ENABLED=true
# Timeout por llamada (segundos) y reintentos sobre el mismo proveedor
# antes de rotar al siguiente (solo errores transitorios: timeout, rate
# limit, 5xx, conexión)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048

# Salida estructurada (Instructor): veces que se reenvía al modelo una
# respuesta que no cumple el schema, con los errores de validación, antes
# de responder 502
LLM_VALIDATION_RETRIES=2

# Caché exact-match de respuestas (en memoria, por proceso)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=256

# Versión de los prompts (carpeta app/prompts/estimation/<versión>/).
# v3 añade la sección de alcance (respuesta "fuera de alcance").
PROMPT_VERSION=v3

# --- Guardrails -----------------------------------------------------------
# Modo de cada guardrail: "log_only" (registra el disparo, no bloquea) o
# "enforce" (aplica su política). Las heurísticas nuevas arrancan en
# log_only: primero se observan los disparos en los logs, luego se activan.
GUARDRAIL_MODERATION_MODE=enforce
GUARDRAIL_INJECTION_MODE=log_only
GUARDRAIL_PII_INPUT_MODE=log_only
GUARDRAIL_PII_OUTPUT_MODE=log_only

# Moderation API de OpenAI. Hace falta aunque el LLM sea Anthropic. Usa una
# clave separada y de permisos mínimos; si se deja vacía, se usa
# OPENAI_API_KEY. Sin ninguna de las dos, la API no arranca.
MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_S=5
# Si la Moderation API no responde: true = rechazar con 503 (fail-closed),
# false = continuar sin moderar y registrarlo (fail-open)
MODERATION_FAIL_CLOSED=true

# Confianza mínima (0-100) de una estimación; por debajo, el modelo debe
# responder "fuera de alcance" con todo a 0
MIN_CONFIDENCE_PCT=30
# Longitud máxima de la descripción (20 a 10000 caracteres)
DESCRIPTION_MAX_LENGTH=2000

# --- Caché semántico (Redis Stack + redisvl) ------------------------------
# off | shadow | active. shadow (por defecto) calcula embedding, consulta y
# escribe en el caché, pero siempre responde con el LLM: sirve para medir
# hits y falsos positivos antes de pasar a active.
SEMANTIC_CACHE_MODE=shadow
# Obligatoria si el modo no es off (la API no arranca sin ella). En local:
# redis://default:<password>@localhost:6379/0. Fuera de local: rediss://
# (TLS) con un usuario ACL de permisos mínimos.
REDIS_URL=
# Solo para docker-compose: contraseña del servicio "redis" (la API recibe
# REDIS_URL construida a partir de ella)
REDIS_PASSWORD=
SEMANTIC_CACHE_INDEX_NAME=estimation_cache
# Distancia coseno máxima para un hit, en (0, 0.3] (0.08 ≈ similitud >= 0.92)
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.08
# Retención de las entradas (300 s a 30 días). Un hit refresca el TTL.
SEMANTIC_CACHE_TTL_SECONDS=86400
# El caché no debe añadir más latencia de la que ahorra
REDIS_SOCKET_TIMEOUT_MS=150

# Embeddings (OpenAI) para el caché. Clave separada y de permisos mínimos;
# si se deja vacía, se usa OPENAI_API_KEY. La dimensión debe coincidir con
# la del índice (si cambias de modelo o dimensión, cambia también
# SEMANTIC_CACHE_INDEX_NAME)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_MS=1000

# --- Sesiones conversacionales (POST /api/v1/sessions/{id}/estimate) ------
# Prompt de las sesiones (v4: <transcript>, <attachment_content> y
# <project_metadata>). /estimate sigue usando PROMPT_VERSION.
SESSION_PROMPT_VERSION=v4
# Ventana deslizante: pares user+assistant previos que se envían al LLM
MAX_TURNS=6
# Memoria del proceso: expiración por inactividad y máximo de sesiones vivas
# (al llegar al máximo, POST /sessions responde 503). Ejecutar con un solo
# worker: las sesiones viven en la memoria de un proceso.
SESSION_TTL_MINUTES=60
MAX_SESSIONS=1000
MAX_TRANSCRIPT_CHARS=20000

# Adjuntos PDF/DOCX (procesados en memoria)
MAX_ATTACHMENTS=5
# Bytes por archivo (10 MB) y en total por petición (25 MB)
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=26214400
MAX_PDF_PAGES=50
# DOCX es un ZIP: límites contra zip bombs (50 MB descomprimidos, entradas)
MAX_DOCX_UNCOMPRESSED_BYTES=52428800
MAX_DOCX_ENTRIES=1000
# Caracteres de texto extraído por adjunto y en total (se trunca con marca)
MAX_ATTACHMENT_CHARS=20000
MAX_TOTAL_ATTACHMENT_CHARS=50000

# Extractor de project_metadata (segunda llamada al LLM por turno)
METADATA_EXTRACTOR_MAX_TOKENS=512

# API keys (dejar vacío en este archivo de ejemplo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Requerido solo si la ANTHROPIC_API_KEY no está vinculada a un workspace por
# defecto (error 400 "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=

# Modelos por proveedor (mejor un snapshot fechado que un alias, para que
# el mismo prompt dé resultados reproducibles)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# URL base de la API REST que consume el cliente de Streamlit
# (streamlit_app.py). Por defecto asume la API corriendo en local con
# uvicorn; en docker-compose se sobreescribe a http://api:8000.
API_BASE_URL=http://localhost:8000
