# Configuración de la aplicación
APP_NAME=estimador-cag
ENVIRONMENT=development
DEBUG=true
PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR o CRITICAL
LOG_LEVEL=INFO

# Proveedor LLM activo: "openai" o "anthropic"
LLM_PROVIDER=anthropic

# API keys (dejar vacío en este archivo de ejemplo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Requerido solo si la ANTHROPIC_API_KEY no está vinculada a un workspace por
# defecto (error 400 "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=

# Modelos por proveedor
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
