        "overview": "Pipeline diario de ventas de tres ERPs a BigQuery con modelo común en dbt y dashboards en Looker Studio",
        "rate": 60,
        "confidence": 70,
        "phases": [
            {"name": "Análisis de fuentes", "hours": 28, "weeks": 1, "confidence": 70,
             "assumptions": ["hay acceso a un entorno de pruebas de cada ERP", "los ERPs usan los mismos códigos de producto"]},
            {"name": "Ingesta", "hours": 64, "weeks": 2, "confidence": 65,
