        ],
        "team": "1 jefe de proyecto a tiempo parcial, 1 diseñador UX/UI, 2 desarrolladores (Flutter y backend) y 1 QA",
        "risks": ["la revisión de Apple puede retrasar la publicación una o dos semanas", "el antifraude del QR puede requerir más iteraciones si hay abusos"],
