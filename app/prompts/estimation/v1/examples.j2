            {"name": "Backend y API de puntos", "hours": 110, "weeks": 3, "confidence": 75,
             "assumptions": ["no hay integración con el TPV existente", "un único programa de puntos común a todos los locales", "incluye el antifraude del QR"]},
            {"name": "App móvil (Flutter, iOS y Android)", "hours": 144, "weeks": 4, "confidence": 70,
