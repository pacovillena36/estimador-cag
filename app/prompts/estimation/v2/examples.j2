{#
  Cada ejemplo se renderiza como una instancia de EstimationResult en JSON
  (un ejemplo de contenido, no una copia del schema). El coste de cada fase
  es horas x tarifa y los totales se calculan aquí, así que los ejemplos
  siempre cumplen los validadores del contrato. El nivel de detalle pedido
  recorta el resumen y las asunciones igual que piden las instrucciones.
#}
{% for ex in examples %}
{% set phases = [] %}
{% for p in ex.phases %}
{% set _ = phases.append({
    "name": p.name,
    "hours": p.hours,
    "duration_weeks": p.weeks,
    "cost_eur": p.hours * ex.rate,
    "confidence_pct": p.confidence,
    "assumptions": p.assumptions[:1] if detail_level == "summary" else p.assumptions,
}) %}
{% endfor %}
{% set total_hours = phases | sum(attribute="hours") %}
{% set total_weeks = phases | sum(attribute="duration_weeks") %}
{% set total_cost = phases | sum(attribute="cost_eur") %}
{% set summary = ex.overview ~ ": unas " ~ total_hours ~ " horas en " ~ total_weeks ~ " semanas, con un coste de " ~ total_cost ~ " € (tarifa media de " ~ ex.rate ~ " €/h)." %}
{% if detail_level != "summary" %}
{% set summary = summary ~ " Riesgos principales: " ~ (ex.risks | join("; ")) ~ "." %}
{% endif %}
{% if detail_level == "detailed" %}
{% set summary = summary ~ " Equipo recomendado: " ~ ex.team ~ "." %}
{% endif %}
